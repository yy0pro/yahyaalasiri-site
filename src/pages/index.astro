---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('articles'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestPosts = posts.slice(0, 3);

const formatDate = (d) =>
  new Intl.DateTimeFormat('ar', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
---
<Base title="يحيى سليمان العسيري | موظف تقني — أنظمة وحلول رقمية" description="أبني وأشغّل أنظمة إلكترونية تحل مشكلات تشغيلية حقيقية، من الفكرة إلى التشغيل المستمر، بالاستفادة من أدوات الذكاء الاصطناعي." active="home">
<main>

  <!-- ============ Hero ============ -->
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1>يحيى العسيري</h1>
        <p class="hero-lead"><span class="lead-a">أبني أنظمة رقمية تحل مشكلات تشغيلية حقيقية.</span> <span>أستخدم الذكاء الاصطناعي وأدوات التطوير الحديثة لتحويل الأفكار والإجراءات إلى أنظمة تعمل فعليًا.</span></p>
        <div class="stack-actions">
          <a class="btn btn-primary" href="#platforms">
            استكشف مشاريعي
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4"/><path d="m10 6-6 6 6 6"/></svg>
          </a>
          <a class="btn btn-ghost" href="/cv">
            تعرف عليّ
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15.5 20v-1.6a4 4 0 0 0-4-4H7.6a4 4 0 0 0-4 4V20"/><circle cx="9.5" cy="7.4" r="3.4"/><path d="M17 11.4a3.2 3.2 0 0 0 0-6.4"/><path d="M20.5 20v-1.6a3.6 3.6 0 0 0-2.4-3.4"/></svg>
          </a>
        </div>
      </div>

      <nav class="hero-index" aria-label="أقسام الصفحة">
        <ol class="index-list">
          <li><a href="#platforms">
            <span class="index-num">01</span><span class="index-name">المنصات</span>
            <svg class="index-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4"/><path d="m10 6-6 6 6 6"/></svg>
          </a></li>
          <li><a href="#how">
            <span class="index-num">02</span><span class="index-name">كيف أعمل</span>
            <svg class="index-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4"/><path d="m10 6-6 6 6 6"/></svg>
          </a></li>
          <li><a href="#writing">
            <span class="index-num">03</span><span class="index-name">المقالات والشروحات</span>
            <svg class="index-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4"/><path d="m10 6-6 6 6 6"/></svg>
          </a></li>
        </ol>
      </nav>
    </div>
  </section>

  <!-- ============ Proof strip ============ -->
  <section class="proof" aria-label="إثبات مباشر">
    <div class="wrap">
      <p class="proof-label">إثبات مباشر</p>
      <ul class="proof-list">
        <li class="proof-card">
          <span class="proof-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3.25 2"/></svg>
          </span>
          <p class="proof-text">خبرة تتجاوز <span class="stat">4</span> سنوات</p>
        </li>
        <li class="proof-card is-live">
          <span class="proof-icon proof-icon--live" aria-hidden="true"><span class="live-dot"></span></span>
          <p class="proof-text">منصتان تعملان الآن</p>
        </li>
        <li class="proof-card">
          <span class="proof-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15.5 20v-1.6a4 4 0 0 0-4-4H7.6a4 4 0 0 0-4 4V20"/><circle cx="9.5" cy="7.4" r="3.4"/><path d="M17 11.4a3.2 3.2 0 0 0 0-6.4"/><path d="M20.5 20v-1.6a3.6 3.6 0 0 0-2.4-3.4"/></svg>
          </span>
          <p class="proof-text">مستخدمون من الشركة ومسؤولو البلدية</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ Platforms ============ -->
  <section class="sec" id="platforms">
    <div class="wrap">
      <div class="sec-head">
        <h2>المنصات</h2>
      </div>
      <p class="sec-intro">أدير دورة كاملة: فهم المشكلة، البناء، الاختبار، النشر، ثم التشغيل والدعم اليومي.</p>

      <div class="platform-grid">

        <article class="card platform-card">
          <div class="card-media">
            <div class="win" aria-hidden="true">
              <div class="win-bar">
                <span class="win-dot"></span><span class="win-dot"></span><span class="win-dot"></span>
                <span class="win-url"></span>
              </div>
              <div class="win-body">
                <div class="win-head">
                  <span class="bar w-38"></span>
                  <span class="chip-live"><span class="live-dot"></span><span class="bar"></span></span>
                </div>
                <div class="win-rows">
                  <div class="win-row">
                    <span class="sk-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s6.4-6.1 6.4-10.4a6.4 6.4 0 1 0-12.8 0C5.6 14.9 12 21 12 21Z"/><circle cx="12" cy="10.4" r="2.4"/></svg></span>
                    <span class="sk-lines"><i class="w-82"></i><i class="w-50"></i></span>
                    <span class="sk-state ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7"/></svg></span>
                  </div>
                  <div class="win-row">
                    <span class="sk-icon sk-photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4.5" width="17" height="15" rx="3"/><circle cx="9" cy="10" r="1.7"/><path d="m5 17.5 4.6-4.6 3.9 3.9L16.9 13l2.4 2.4"/></svg></span>
                    <span class="sk-lines"><i class="w-72"></i><i class="w-45"></i></span>
                    <span class="sk-state ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7"/></svg></span>
                  </div>
                  <div class="win-row">
                    <span class="sk-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s6.4-6.1 6.4-10.4a6.4 6.4 0 1 0-12.8 0C5.6 14.9 12 21 12 21Z"/><circle cx="12" cy="10.4" r="2.4"/></svg></span>
                    <span class="sk-lines"><i class="w-64"></i><i class="w-30"></i></span>
                    <span class="sk-state"></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="card-body">
            <div class="card-top">
              <h3>منصة توثيق الأعمال الميدانية</h3>
              <span class="badge-live"><span class="live-dot" aria-hidden="true"></span>تعمل الآن</span>
            </div>
            <p>منصة إلكترونية لتوثيق الأعمال الميدانية والمواقع والفرق، مع رفع الصور وإصدار التقارير وأرشفتها. يستخدمها موظفو الشركة في الميدان، ويتابع عبرها مسؤولو البلدية سير الأعمال ويراجعونها. أتولى تشغيلها ودعم مستخدميها والتطوير المستمر عليها.</p>
          </div>
          <div class="card-foot">
            <span class="pill-muted">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3.25 2"/></svg>
              جولة تجريبية — قريباً
            </span>
          </div>
        </article>

        <article class="card platform-card">
          <div class="card-media">
            <div class="win" aria-hidden="true">
              <div class="win-bar">
                <span class="win-dot"></span><span class="win-dot"></span><span class="win-dot"></span>
                <span class="win-url"></span>
              </div>
              <div class="win-body">
                <div class="att-top">
                  <svg class="att-ring" viewBox="0 0 46 46"><circle class="ring-bg" cx="23" cy="23" r="18"/><circle class="ring-fg" cx="23" cy="23" r="18"/></svg>
                  <span class="sk-lines"><i class="w-58"></i><i class="w-30"></i></span>
                </div>
                <div class="att-actions">
                  <span class="att-btn att-btn--solid">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7"/></svg>
                    <span class="bar w-50"></span>
                  </span>
                  <span class="att-btn att-btn--ghost">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3.25 2"/></svg>
                    <span class="bar w-50"></span>
                  </span>
                </div>
                <div class="att-week">
                  <span></span><span class="is-done"></span><span class="is-done"></span><span class="is-today"></span><span></span><span></span>
                </div>
                <div class="att-sign">
                  <svg viewBox="0 0 120 26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 20c7.5 0 8.5-15 13.5-15s4 13 8.5 13 5.5-9 9.5-9 3.5 7 9 7 8-5 10.5-8"/><path d="M62 12.5c9-1.5 20-1 29-3.5"/></svg>
                </div>
              </div>
            </div>
          </div>
          <div class="card-body">
            <div class="card-top">
              <h3>منصة الحضور والانصراف</h3>
              <span class="badge-live"><span class="live-dot" aria-hidden="true"></span>تعمل الآن</span>
            </div>
            <p>بوابة إلكترونية للموظفين لتسجيل الحضور والانصراف بتوقيع إلكتروني موثّق، مرتبطة بجدول دوام كل موظف، وتمكّن الإدارة من متابعة الالتزام بدقة. أتولى تشغيلها ودعم مستخدميها وصيانتها.</p>
          </div>
          <div class="card-foot">
            <span class="pill-muted">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3.25 2"/></svg>
              جولة تجريبية — قريباً
            </span>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- ============ How I work ============ -->
  <section class="sec band" id="how">
    <div class="wrap">
      <div class="sec-head">
        <h2>كيف أعمل</h2>
      </div>
      <div class="steps">
        <article class="step">
          <span class="step-num" aria-hidden="true">01</span>
          <h3>أفهم المشكلة أولاً</h3>
          <p>أبدأ من سير العمل الفعلي والمشكلات اليومية، لا من التقنية.</p>
        </article>
        <article class="step">
          <span class="step-num" aria-hidden="true">02</span>
          <h3>أبني بسرعة وأختبر بجدية</h3>
          <p>أستخدم أدوات الذكاء الاصطناعي في البناء، مع اختبارات ومراجعات قبل أي نشر.</p>
        </article>
        <article class="step">
          <span class="step-num" aria-hidden="true">03</span>
          <h3>أشغّل وأدعم باستمرار</h3>
          <p>النشر ليس النهاية: تشغيل يومي، ودعم للمستخدمين، وتحسين مستمر.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ Articles teaser ============ -->
  <section class="sec" id="writing">
    <div class="wrap">
      <div class="sec-head">
        <h2>المقالات والشروحات</h2>
      </div>
      {latestPosts.length > 0 ? (
        <>
          <p class="sec-intro">شروحات مبسطة عن بناء الأنظمة بالذكاء الاصطناعي وأدوات التقنية اليومية.</p>
          <ul class="articles">
            {latestPosts.map((post, i) => (
              <li class="article-row">
                <span class="article-mark" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div class="article-main">
                  <h3><a href={'/articles/' + post.id + '/'}>{post.data.title}</a></h3>
                  {post.data.description && <p>{post.data.description}</p>}
                </div>
                <span class="post-date">{formatDate(post.data.date)}</span>
                <a class="btn btn-ghost btn-sm read-more" href={'/articles/' + post.id + '/'}>اقرأ المقال <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4"/><path d="m10 6-6 6 6 6"/></svg></a>
              </li>
            ))}
          </ul>
          <a class="link-more" href="/articles">
            تصفح جميع المقالات
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4"/><path d="m10 6-6 6 6 6"/></svg>
          </a>
        </>
      ) : (
        <>
          <p class="sec-intro">سأنشر هنا شروحات مبسطة عن بناء الأنظمة بالذكاء الاصطناعي وأدوات التقنية اليومية.</p>
          <ul class="articles">
            <li class="article-row">
              <span class="article-mark" aria-hidden="true">01</span>
              <div class="article-main">
                <h3>لماذا أبني الأنظمة بالذكاء الاصطناعي؟</h3>
                <p>عن الطريقة التي أبني بها أنظمة كاملة دون خلفية برمجية تقليدية.</p>
              </div>
              <span class="pill-soon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3.25 2"/></svg>
                قريباً
              </span>
            </li>
            <li class="article-row">
              <span class="article-mark" aria-hidden="true">02</span>
              <div class="article-main">
                <h3>من الفكرة إلى نظام يعمل: قصة منصتين</h3>
                <p>كيف تحولت مشكلات تشغيلية يومية إلى منصتين يستخدمهما الجميع.</p>
              </div>
              <span class="pill-soon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3.25 2"/></svg>
                قريباً
              </span>
            </li>
            <li class="article-row">
              <span class="article-mark" aria-hidden="true">03</span>
              <div class="article-main">
                <h3>التوقيع الإلكتروني بدون ورق</h3>
                <p>شرح مبسط لكيفية عمل منصة الحضور والانصراف.</p>
              </div>
              <span class="pill-soon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3.25 2"/></svg>
                قريباً
              </span>
            </li>
          </ul>
          <a class="link-more" href="/articles">
            تصفح جميع المقالات
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4"/><path d="m10 6-6 6 6 6"/></svg>
          </a>
        </>
      )}
    </div>
  </section>

  <!-- ============ Contact ============ -->
  <section class="contact" id="contact">
    <div class="wrap">
      <div class="contact-inner">
        <p class="contact-kicker">تواصل</p>
        <h2>هل لديكم فرصة تقنية أو مشروع يحتاج نظاماً يعمل؟</h2>
        <div class="contact-actions">
          <a class="btn btn-primary" href="mailto:yahya4job@gmail.com">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2.6"/><path d="m4.5 8.5 7.5 5 7.5-5"/></svg>
            <span>راسلني عبر البريد</span>
          </a>
          <a class="btn btn-ghost" href="https://wa.me/966597754818">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.6 3.6h3l1.5 4-2.1 1.5a11.5 11.5 0 0 0 6.4 6.4l1.5-2.1 4 1.5v3a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 4.6 5.8 2 2 0 0 1 6.6 3.6Z"/></svg>
            <span>راسلني على واتساب</span>
          </a>
        </div>
        <p class="contact-country">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s6.4-6.1 6.4-10.4a6.4 6.4 0 1 0-12.8 0C5.6 14.9 12 21 12 21Z"/><circle cx="12" cy="10.4" r="2.4"/></svg>
          المملكة العربية السعودية
        </p>
      </div>
    </div>
  </section>

</main>
</Base>
